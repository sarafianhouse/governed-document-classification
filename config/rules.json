  "routingPolicy": {
    "mode": "recommendation-only",
    "physicalMovementEnabled": false,
    "defaultDestination": "Intake / Exception Review",
    "highConfidenceEligible": false,
    "humanApprovalRequired": true
  },
  "sensitivityPolicy": {
    "automatedChangesAllowed": false,
    "pilotValue": "General",
    "pilotSource": "Human Reviewed"
  },
  "competingRulePolicy": {
    "penalty": 15,
    "window": 10,
    "appliesOnlyToConflictingClasses": true,
    "compatibleClassGroups": [
      [
        "Marketing Material",
        "Report",
        "Presentation",
        "Retail Presentation",
        "Sell Sheet"
      ],
      [
        "Product Specification",
        "Marketing Material",
        "Sell Sheet"
      ],
      [
        "Quote",
        "Correspondence"
      ],
      [
        "Agreement",
        "Contract"
      ],
      [
        "Policy",
        "Procedure"
      ],
      [
        "Sell Sheet",
        "Retail Presentation",
        "Marketing Material",
        "Report"
      ]
    ],
    "tieBreak": "specificity, then ruleId"
  },
  "legacyFormatFallback": {
    "ppt": "Presentation",
    "xls": "Spreadsheet",
    "score": 60,
    "note": "Unsupported legacy or size-skipped Office file; classified by file type only, always human review",
    "includeSizeSkippedOffice": true
  },
  "formatRules": {
    "ruleIds": [
      "PRS-001",
      "SHT-001",
      "MED-001"
    ],
    "note": "File-format classes take precedence as ContentClass; the best non-format rule is reported separately as ContentTopic and never penalizes the format class."
  },
  "pathEvidence": {
    "enabled": true,
    "note": "Folder names and file names are a second, weaker evidence source. Path signals only add supporting points to a rule whose text evidence already matched; they never satisfy requiredSignals, never change which rule wins, never create a competing-rule penalty, and (by default) never lift a document from MEDIUM to HIGH. For files with no usable text match, a folder class hint can suggest a class at MEDIUM at most, always with human review. Tags (retailers, products, brands, partners, year, lifecycle) are search metadata and never change class, score or review status. Vocabulary is configuration: extend it from your own folder structure.",
    "supportingSignalWeight": 5,
    "maximumPathBonus": 10,
    "pathBonusCanCrossHighThreshold": false,
    "pathOnlyFallback": {
      "score": 65,
      "agreeingTextBonus": 5,
      "maximumScore": 75
    },
    "classHintSignalsUseFoldersOnly": true,
    "noiseSegments": [
      "presentation storage",
      "desktop",
      "documents",
      "my documents",
      "new folder( \\d+)?",
      "misc(ellaneous)?",
      "stuff",
      "shared( with me)?",
      "downloads?",
      "temp",
      "tmp",
      "untitled( folder)?",
      "my drive",
      "onedrive",
      "root",
      "general",
      "files",
      "folder",
      "copy",
      "\\d{1,3}",
      "system volume information",
      "_?restore(?: [0-9a-f ]+)?",
      "favorites",
      "move(?: \\d+)*",
      "screenshots",
      "previews"
    ],
    "folderSignals": {
      "pathInvoiceFolder": {
        "pattern": "\\binvoices?\\b|\\bbilling\\b|\\bbills\\b|\\bpayables?\\b",
        "classHint": "Invoice",
        "businessFunction": "Finance"
      },
      "pathPurchaseOrderFolder": {
        "pattern": "\\bpurchase orders?\\b|\\bpos\\b",
        "classHint": "Purchase Order",
        "businessFunction": "Finance"
      },
      "pathQuoteFolder": {
        "pattern": "\\bquotes?\\b|\\bquotations?\\b",
        "classHint": "Quote"
      },
      "pathReceiptFolder": {
        "pattern": "\\breceipts?\\b",
        "classHint": "Receipt",
        "businessFunction": "Finance"
      },
      "pathContractFolder": {
        "pattern": "\\bcontracts?\\b",
        "classHint": "Contract",
        "businessFunction": "Legal"
      },
      "pathAgreementFolder": {
        "pattern": "\\bagreements?\\b|\\bndas?\\b",
        "classHint": "Agreement",
        "businessFunction": "Legal"
      },
      "pathLegalFolder": {
        "pattern": "\\blegal\\b|\\bcompliance\\b",
        "businessFunction": "Legal"
      },
      "pathReportFolder": {
        "pattern": "\\breports?\\b|\\breporting\\b|\\baudits?\\b",
        "classHint": "Report"
      },
      "pathPolicyFolder": {
        "pattern": "\\bpolic(?:y|ies)\\b",
        "classHint": "Policy"
      },
      "pathProcedureFolder": {
        "pattern": "\\bprocedures?\\b|\\bsops?\\b",
        "classHint": "Procedure"
      },
      "pathMarketingFolder": {
        "pattern": "\\bmarketing\\b|\\bmarkting\\b|\\badvertising\\b|\\bprint ads?\\b|\\bads\\b|\\bpress\\b|\\bpr\\b|\\bsocial media\\b|\\btrade ?shows?\\b|\\bdisplays?\\b|\\bpromotions?\\b|\\bsummits?\\b",
        "classHint": "Marketing Material",
        "businessFunction": "Marketing"
      },
      "pathSellSheetFolder": {
        "pattern": "\\bsell ?sheets?\\b",
        "classHint": "Sell Sheet",
        "businessFunction": "Sales"
      },
      "pathSpecFolder": {
        "pattern": "\\bsup(?:plement)? facts\\b|\\bspecs?\\b|\\bspecifications?\\b|\\bformulas?\\b|\\blabels?\\b|\\bcoas?\\b",
        "classHint": "Product Specification",
        "businessFunction": "Product Development"
      },
      "pathFinanceFolder": {
        "pattern": "\\bfinance\\b|\\baccounting\\b|\\btax(?:es)?\\b|\\bpayroll\\b|\\bbookkeeping\\b|\\bquickbooks\\b",
        "businessFunction": "Finance"
      },
      "pathPresentationFolder": {
        "pattern": "\\bpresentations?\\b|\\bpowerpoints?\\b|\\bdecks?\\b|\\bmeetings?\\b|\\bline reviews?\\b"
      },
      "pathMediaFolder": {
        "pattern": "\\bimages?\\b|\\bphotos?\\b|\\bpictures?\\b|\\bvideos?\\b|\\bmedia\\b|\\bgraphics\\b|\\bartwork\\b|\\bcamera uploads\\b|\\bscreenshots?\\b|\\bhigh res\\b|\\balbums?\\b|\\bproduct shots?\\b"
      },
      "pathSalesFolder": {
        "pattern": "\\baccounts?\\b|\\bbroker\\b|\\bsales\\b|\\bretail(?:ers?)?\\b|\\bcustomers?\\b|\\bstore shops?\\b",
        "businessFunction": "Sales"
      },
      "pathCreativeFolder": {
        "pattern": "\\bart ?department\\b|\\bart ?work\\b|\\bcreative\\b|\\bdesign\\b",
        "businessFunction": "Marketing"
