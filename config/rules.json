      "ruleId": "INV-001",
      "ruleVersion": "1.0",
      "targetClass": "Invoice",
      "requiredSignals": [
        "invoiceNumber",
        "invoiceDate",
        "amountDue"
      ],
      "minimumRequiredSignals": 2,
      "supportingSignals": [
        "invoiceHeading",
        "billTo",
        "invoiceTotal",
        "subtotal",
        "tax",
        "paymentTerms",
        "lineItemLanguage"
      ],
      "contradictorySignals": [
        "quoteLanguage",
        "supplementFactsLanguage"
      ],
      "minimumEvidence": 2,
      "confidenceCalculation": {
        "base": 25,
        "requiredSignalWeight": 20,
        "supportingSignalWeight": 5,
        "contradictorySignalPenalty": 45,
        "maximum": 100
      },
      "businessFunction": "Finance",
      "routingRecommendation": "Finance Workflow",
      "humanReviewConditions": [
        "confidence below 85",
        "quote language conflicts with invoice evidence",
        "missing invoice-specific identifiers or amounts"
      ],
      "specificity": 90,
      "pathSupportingSignals": [
        "pathInvoiceFolder",
        "pathFinanceFolder"
      ]
    },
